Component PluginCard (icon string, name string, description string, accent string)

<div class="p-6 bg-white rounded-2xl border border-slate-200 shadow-sm">
    <div class="w-12 h-12 {{ accent }} rounded-xl flex items-center justify-center mb-4">
        <span class="text-2xl" aria-hidden="true">{{ icon }}</span>
    </div>
    <h3 class="text-lg font-semibold text-slate-900 mb-2">{{ name }}</h3>
    <p class="text-sm text-slate-500 mb-4">{{ description }}</p>
    <div class="flex flex-wrap gap-2 text-xs">
        {#slot}
    </div>
</div>
