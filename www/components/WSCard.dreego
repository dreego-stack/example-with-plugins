Component WSCard ()

<body class="p-6 bg-white rounded-2xl border border-slate-200 shadow-sm">
    <h3 class="text-lg font-semibold text-slate-900 mb-2 flex items-center gap-2">
        <span class="w-3 h-3 rounded-full bg-purple-500" aria-hidden="true"></span>
        WebSocket</h3>
    <p class="text-sm text-slate-500 mb-4">Latest broadcast:</p>
    <div id="ws-msg" aria-live="polite" class="p-3 bg-slate-900 rounded-xl font-mono text-purple-400 text-sm mb-4">
        not connected</div>
    <script>
        window.wsHandlers = [];
        window.wsSendQueue = [];
        const wsMsg = document.getElementById("ws-msg");
        function wsConnect() {
            const socket = new WebSocket("ws://" + location.host + "/ws");
            window.wsSocket = socket;
            socket.onopen = () => {
                wsMsg.textContent = "connected, waiting for broadcast...";
                while (window.wsSendQueue.length) {
                    socket.send(window.wsSendQueue.shift());
                }
            };
            socket.onmessage = (e) => {
                window.wsHandlers.forEach(function(h) { h(e.data); });
            };
            socket.onclose = () => {
                wsMsg.textContent = "disconnected, reconnecting...";
                setTimeout(wsConnect, 2000);
            };
        }
        wsConnect();
    </script>
</body>
