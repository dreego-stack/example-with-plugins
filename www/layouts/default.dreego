<body>
<!DOCTYPE html>
<html lang="en">
<head>
    <title>Example with Plugins</title>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="stylesheet" href="/tailwind.css">
    {#head}
</head>
<body class="min-h-screen bg-slate-50 text-slate-900 font-sans antialiased">

    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:top-4 focus:left-4 focus:z-50 focus:bg-slate-900 focus:text-white focus:px-4 focus:py-2 focus:rounded-lg">skip to content</a>

    <header class="sticky top-0 z-40 backdrop-blur-xl bg-white/80 border-b border-slate-200/60">
        <nav aria-label="Primary" class="max-w-4xl mx-auto px-6 h-16 flex items-center justify-between">
            <a href="/" class="text-xl font-bold tracking-tight text-slate-900">
                Dreego<span class="text-blue-600">.</span>Plugins</a>
            <div class="flex items-center gap-6 text-sm font-medium text-slate-600">
                <a href="/" class="hover:text-slate-900 transition-colors">Home</a>
                <a href="/about" class="hover:text-slate-900 transition-colors">About</a>
                <a href="/example/health" class="hover:text-slate-900 transition-colors">Health</a>
                <a href="https://github.com/dreego-stack/dreego" class="text-slate-400 hover:text-slate-900 transition-colors" aria-label="GitHub repository">GitHub</a>
            </div>
        </nav>
    </header>

    <main id="main" class="max-w-4xl mx-auto px-6 py-12">
    {#slot}
    </main>

    <footer class="border-t border-slate-200 mt-16">
        <div class="max-w-4xl mx-auto px-6 py-8 text-center">
            <p class="text-sm text-slate-400">Built with Dreego + plugin-tailwind + plugin-sse + plugin-websocket</p>
        </div>
    </footer>

</body>
</html>
</body>
