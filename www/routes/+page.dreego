import Button "components/dreegoui/Button.dreego"
import Card "components/dreegoui/Card.dreego"
import CodeBox "components/dreegoui/CodeBox.dreego"
import Footer "components/dreegoui/Footer.dreego"
import Icon "components/dreegoui/Icon.dreego"
import Navbar "components/dreegoui/Navbar.dreego"
import PageShell "components/dreegoui/PageShell.dreego"
import PriceCard "components/dreegoui/PriceCard.dreego"
import Sidebar "components/dreegoui/Sidebar.dreego"
import ThemePicker "components/dreegoui/ThemePicker.dreego"
import Toggle "components/dreegoui/Toggle.dreego"
import PluginCard "components/PluginCard.dreego"
import PluginGrid "components/PluginGrid.dreego"
import LiveDemos "components/LiveDemos.dreego"
import SSECard "components/SSECard.dreego"
import WSCard "components/WSCard.dreego"
import WSEcho "components/WSEcho.dreego"
import TailwindSection "components/TailwindSection.dreego"

<head>
    <title>Dreego UI · Plugin ecosystem</title>
    <meta name="description" content="Dreego UI and plugin ecosystem showcase">
    <link rel="stylesheet" href="/dreego-ui/theme.css">
</head>

<server>
    themes := []dreegoui.ThemeOption{
        {ID: "white", Name: "White"},
        {ID: "black", Name: "Black"},
    }
    selectedTheme := c.SessionVal(dreegoui.DefaultThemeSessionKey)
</server>

<body>
    <a class="sr-only focus:not-sr-only" href="#main">Skip to content</a>
    <@PageShell>
        {#slot header}
            <@Navbar label="Primary navigation">
                {#slot brand}<a href="/" class="text-xl font-bold tracking-tight">Dreego<span class="text-teal-500">.</span>Plugins</a>{/slot}
                <a href="#plugins">Plugins</a>
                <a href="#live">Live demos</a>
                {#slot actions}
                    <@ThemePicker id="theme-choice" themes={themes} csrfToken={c.CSRFToken()} selected={selectedTheme} returnTo="/"/>
                {/slot}
            </@Navbar>
        {/slot}
        {#slot sidebar}
            <@Sidebar label="Showcase navigation">
                <a href="#plugins"><@Icon name="code"/> Active plugins</a>
                <a href="#live"><@Icon name="arrow-right"/> Live demos</a>
                <a href="#pricing"><@Icon name="shield"/> UI foundations</a>
                {#slot footer}<span>SSR first · Go native</span>{/slot}
            </@Sidebar>
        {/slot}

        <section class="py-12 md:py-20" aria-labelledby="hero-title">
            <p class="text-sm font-semibold uppercase tracking-widest text-teal-600">Calm · precise · private</p>
            <h1 id="hero-title" class="mt-4 max-w-4xl text-5xl font-extrabold tracking-tight text-slate-950 md:text-7xl">Plugins that feel like one product.</h1>
            <p class="mt-6 max-w-2xl text-lg leading-8 text-slate-600">A Dreego application combining real-time plugins with a typed, themeable interface system.</p>
            <div class="mt-8 flex flex-wrap gap-3">
                <@Button disabled={false} kind="submit">Explore the system</@Button>
                <@Button disabled={false} variant="secondary"><a href="#plugins">View plugins</a></@Button>
            </div>
        </section>

        <section id="plugins" aria-labelledby="plugins-heading">
            <h2 id="plugins-heading" class="text-3xl font-bold tracking-tight text-slate-950">Active plugins</h2>
            <div class="mt-6 grid gap-5 md:grid-cols-3">
                <@PluginCard icon="🔌" name="plugin-example" description="Greeting and health endpoints." accent="bg-teal-100"><code>/example/health</code></@PluginCard>
                <@PluginCard icon="📡" name="plugin-sse" description="Server-Sent Events streaming." accent="bg-emerald-100"><code>/sse</code></@PluginCard>
                <@PluginCard icon="⚡" name="plugin-websocket" description="Bidirectional communication." accent="bg-slate-200"><code>/ws</code></@PluginCard>
            </div>
        </section>

        <section id="live" class="mt-16" aria-labelledby="live-heading">
            <h2 id="live-heading" class="text-3xl font-bold tracking-tight text-slate-950">Live demos</h2>
            <div class="mt-6 grid gap-5 md:grid-cols-2"><@SSECard/><@WSCard/><@WSEcho/></div>
        </section>

        <section id="pricing" class="mt-16" aria-labelledby="pricing-heading">
            <h2 id="pricing-heading" class="text-3xl font-bold tracking-tight text-slate-950">UI foundations</h2>
            <div class="mt-6 grid gap-5 md:grid-cols-2">
                <@Card>
                    {#slot header}<h3 class="text-xl font-semibold">Typed controls</h3>{/slot}
                    <p class="text-slate-600">Native semantics, visible focus, and themes owned by the application.</p>
                    <@Toggle id="privacy" name="privacy" label="Privacy protection" checked={true} disabled={false}/>
                    <@CodeBox code="ui.Register(app, ui.Options)" language="go" label="Theme registration"/>
                </@Card>
                <@PriceCard id="plugin-ui" title="Dreego UI" price="Go" period="native" description="Composable SSR foundations." ctaLabel="Read the docs" href="/about" featured={true}>
                    {#slot features}<ul><li>White and Black themes</li><li>Custom theme registry</li><li>Accessible components</li></ul>{/slot}
                </@PriceCard>
            </div>
        </section>

        <section class="mt-16"><@TailwindSection/></section>
        {#slot footer}<@Footer><span>Dreego UI · Plugin showcase</span>{#slot meta}<span>Built with SSR and Go</span>{/slot}</@Footer>{/slot}
    </@PageShell>
</body>
